<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Feedback Management</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f4f6f9; }
        header { background: #1f3a5f; color: #fff; padding: 14px 30px; }
        nav a { color: #fff; margin-right: 18px; text-decoration: none; }
        .container { max-width: 900px; margin: 25px auto; background: #fff; padding: 25px; }
        footer { text-align: center; color: #777; padding: 15px; font-size: 13px; }
        .field-validation-error { color: #c0392b; font-size: 13px; }
        .input-validation-error { border: 1px solid #c0392b; }
    </style>
</head>
<body>
    <header>
        <h2>Feedback Management System</h2>
        <nav>
            @Html.ActionLink("All Feedback", "Index", "Feedback")
            @Html.ActionLink("Give Feedback", "Create", "Feedback")
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer>&copy; @DateTime.Now.Year - Marwadi University</footer>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
